{
    "manifest_version": 3,
    "name": "Lectoro - Translation & Reader",
    "version": "1.0.0",
    "description": "Select any word or sentence, click the translate icon, and get an instant translation. Choose your target language in the popup.",
    "key": "",
    "permissions": [
        "storage",
        "unlimitedStorage",
        "alarms",
        "notifications",
        "identity"
    ],
    "host_permissions": [
        "https://identitytoolkit.googleapis.com/*",
        "https://firestore.googleapis.com/*",
        "https://securetoken.googleapis.com/*",
        "https://europe-west1-extension-eng.cloudfunctions.net/*",
        "https://geminiproxy-gyagzflbra-ew.a.run.app/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Lectoro - Settings"
    },
    "icons": {
        "48": "icon48.png"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "css": ["styles.css"],
            "js": [
                "functions/subscription-config.js",
                "shared/utils.js",
                "shared/audio-cache.js",
                "shared/ai-prompts.js",
                "firebase/firebase-config.js",
                "firebase/firebase-sync.js",
                "shared/subscription-service.js",
                "shared/gemini-proxy.js",
                "core.js",
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
