rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Subscription, Stripe and usage fields are server/admin-owned. The
      // authoritative plan is a Firebase Auth Custom Claim; this document only
      // contains its optional admin-written mirror for display/auditing.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny([
                      'plan',
                      'aiCallsThisMonth', 'aiCallsResetDate',
                      'elevenLabsCharactersThisMonth', 'elevenLabsResetDate',
                      'subscriptionStatus', 'stripeCustomerId', 'stripeSubscriptionId'
                    ]);
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'plan', 'aiCallsThisMonth', 'aiCallsResetDate',
                      'elevenLabsCharactersThisMonth', 'elevenLabsResetDate',
                      'subscriptionStatus', 'stripeCustomerId', 'stripeSubscriptionId'
                    ]);
      // Deleting the profile would reset server-owned monthly counters.
      allow delete: if false;

      // User-owned learning data (currently users/{uid}/words/{wordId}).
      match /{document=**} {
        allow read, create, update, delete: if request.auth != null
                                            && request.auth.uid == userId;
      }
    }
  }
}
